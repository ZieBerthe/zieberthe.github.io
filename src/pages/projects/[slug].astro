---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PdfViewer from '../../components/PdfViewer.astro';
import { projects, type Project } from '../../data/projects';

export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
const { title, description, tags, href, repoUrl, report, poster, readmeHtml } = project;
const btn =
  'rounded-lg border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 transition hover:border-accent hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:text-zinc-100';
---

<BaseLayout title={title} description={description || title}>
  <article>
    <a
      href="/projects"
      class="inline-flex items-center gap-1 text-sm text-zinc-500 transition hover:text-accent-strong dark:text-zinc-400 dark:hover:text-accent"
    >
      ← All projects
    </a>

    <header class="mt-6 border-b border-zinc-200/70 pb-6 dark:border-zinc-800/70">
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">{title}</h1>
      {description && <p class="mt-3 text-zinc-600 dark:text-zinc-400">{description}</p>}
      {
        tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <li class="rounded bg-zinc-100 px-2 py-0.5 font-mono text-[11px] text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
      <div class="mt-5 flex flex-wrap gap-3">
        {
          repoUrl && (
            <a href={repoUrl} target="_blank" rel="noopener noreferrer" class={btn}>
              View on GitHub ↗
            </a>
          )
        }
        {
          href && (
            <a href={href} target="_blank" rel="noopener noreferrer" class={btn}>
              Live ↗
            </a>
          )
        }
      </div>
    </header>

    {
      report && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100">Report</h2>
          <PdfViewer src={report} label="report" />
        </section>
      )
    }
    {
      poster && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100">Poster</h2>
          <PdfViewer src={poster} label="poster" />
        </section>
      )
    }

    {
      readmeHtml && (
        <section class="mt-8">
          <h2 class="mb-2 font-mono text-xs tracking-wide text-zinc-400 uppercase">README</h2>
          <div class="prose readme" set:html={readmeHtml} />
        </section>
      )
    }
  </article>
</BaseLayout>
