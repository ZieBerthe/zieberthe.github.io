---
import { site } from '../site.config';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-zinc-200/70 dark:border-zinc-800/70">
  <div
    class="mx-auto flex max-w-3xl flex-col items-center justify-between gap-4 px-5 py-8 text-sm text-zinc-500 sm:flex-row dark:text-zinc-400"
  >
    <p>© {year} {site.name}. Built with Astro.</p>
    <SocialLinks />
  </div>
</footer>
