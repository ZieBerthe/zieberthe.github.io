---
/** Inline PDF viewer with a download button. Embedded view is hidden on small screens. */
interface Props {
  src: string;
  label?: string;
}
const { src, label = 'PDF' } = Astro.props;
---

<div class="my-8">
  <div class="flex flex-wrap gap-3">
    <a
      href={src}
      target="_blank"
      rel="noopener"
      class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 transition hover:border-accent hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:text-zinc-100"
    >
      Open {label} ↗
    </a>
    <a
      href={src}
      download
      class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 transition hover:border-accent hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:text-zinc-100"
    >
      Download {label}
    </a>
  </div>
  <object
    data={src}
    type="application/pdf"
    class="mt-5 hidden h-[85vh] w-full rounded-lg border border-zinc-200 md:block dark:border-zinc-800"
  >
    <p class="p-4 text-sm text-zinc-500">
      Your browser can't display the PDF here — <a href={src} class="underline">open it instead</a>.
    </p>
  </object>
</div>
