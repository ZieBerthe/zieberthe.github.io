---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, description, tags, href, repo, image } = project;
---

<article
  class="group flex flex-col overflow-hidden rounded-xl border border-zinc-200 bg-white transition hover:border-accent/60 hover:shadow-sm dark:border-zinc-800 dark:bg-zinc-900/50 dark:hover:border-accent/60"
>
  {
    image ? (
      <img src={image} alt={title} class="aspect-[16/9] w-full object-cover" loading="lazy" />
    ) : (
      <div class="aspect-[16/9] w-full bg-gradient-to-br from-accent/20 via-transparent to-accent/10" />
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">{title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
      {description}
    </p>

    <ul class="mt-4 flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <li class="rounded bg-zinc-100 px-2 py-0.5 font-mono text-[11px] text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
            {tag}
          </li>
        ))
      }
    </ul>

    <div class="mt-4 flex items-center gap-4 text-sm">
      {
        href && (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-accent-strong hover:underline dark:text-accent"
          >
            Live ↗
          </a>
        )
      }
      {
        repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
          >
            Code ↗
          </a>
        )
      }
    </div>
  </div>
</article>
