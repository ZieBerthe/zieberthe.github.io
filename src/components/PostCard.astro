---
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  pdf?: boolean;
}
const { href, title, description, date, tags = [], pdf = false } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const iso = date.toISOString();
---

<article class="group border-b border-zinc-200/70 py-6 last:border-b-0 dark:border-zinc-800/70">
  <a href={href} class="block">
    <div class="flex items-baseline justify-between gap-4">
      <h3
        class="text-lg font-semibold text-zinc-900 transition group-hover:text-accent-strong dark:text-zinc-100 dark:group-hover:text-accent"
      >
        {title}
        {
          pdf && (
            <span class="ml-2 rounded bg-accent/15 px-1.5 py-0.5 align-middle font-mono text-[10px] font-medium text-accent-strong dark:text-accent">
              PDF
            </span>
          )
        }
      </h3>
      <time datetime={iso} class="shrink-0 font-mono text-xs text-zinc-400 dark:text-zinc-500">
        {dateStr}
      </time>
    </div>
    <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="font-mono text-[11px] text-zinc-400 dark:text-zinc-500">#{tag}</li>
          ))}
        </ul>
      )
    }
  </a>
</article>
