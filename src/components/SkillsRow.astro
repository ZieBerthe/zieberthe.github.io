---
import { skills } from '../site.config';
---

<ul class="flex flex-wrap gap-2">
  {
    skills.map((skill) => (
      <li class="rounded-full border border-zinc-200 bg-white px-3 py-1 font-mono text-xs text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
        {skill}
      </li>
    ))
  }
</ul>
