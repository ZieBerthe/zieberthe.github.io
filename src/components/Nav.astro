---
import { site, navLinks } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';
import SocialLinks from './SocialLinks.astro';

// Normalise the current path so the active nav link highlights correctly.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const clean = href.replace(/\/+$/, '') || '/';
  return clean === '/' ? path === '/' : path === clean || path.startsWith(clean + '/');
};
---

<header
  class="sticky top-0 z-40 border-b border-zinc-200/70 bg-zinc-50/80 backdrop-blur-md dark:border-zinc-800/70 dark:bg-zinc-950/80"
>
  <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-5">
    <a
      href="/"
      class="font-mono text-sm font-semibold tracking-tight text-zinc-900 transition hover:text-accent-strong dark:text-zinc-100 dark:hover:text-accent"
    >
      {site.name}
    </a>

    <div class="flex items-center gap-1">
      <nav class="mr-1 hidden items-center gap-1 sm:flex" aria-label="Primary">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-1.5 text-sm transition',
                isActive(link.href)
                  ? 'text-zinc-900 dark:text-zinc-100'
                  : 'text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <SocialLinks class="hidden sm:flex" />
      <ThemeToggle />
    </div>
  </div>

  <!-- Mobile nav -->
  <nav
    class="flex items-center justify-center gap-1 border-t border-zinc-200/70 px-5 py-2 sm:hidden dark:border-zinc-800/70"
    aria-label="Primary mobile"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'rounded-md px-3 py-1.5 text-sm transition',
            isActive(link.href)
              ? 'text-zinc-900 dark:text-zinc-100'
              : 'text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100',
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
